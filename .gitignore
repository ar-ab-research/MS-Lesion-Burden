# patient data and anything derived from it stays local, regenerated by the pipeline
data/
outputs/
cache/
# the public demo scans the site is built from. they reach github through the gh-pages
# branch only, never through main
viewer/public/data/

# the local config holds local paths. config.example.yaml is the committed one
/config.yaml

# imaging and tabular files are never committed, wherever they sit
*.nii
*.nii.gz
*.mgz
*.mgh
*.dcm
*.nrrd
*.npy
*.npz
*.pt
*.xlsx
*.xls
*.csv
*.tsv
# the empty schema templates are the one exception
!templates/*.csv

# python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
.pytest_cache/

# viewer
node_modules/
dist/
.vite/

# agent tooling config and working notes, local only
.claude/
PLAN.md
